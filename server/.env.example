# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Database (Supabase PostgreSQL)
# Transaction Connection Pooler (Port 6543 - for application runtime)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432 - for Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Admin Auth
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d

# Shopify Integration
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# CJ Dropshipping Integration
CJ_API_EMAIL=your-cj-email@example.com
CJ_API_KEY=your_cj_api_key_or_token
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# Zendrop Backup Integration
ZENDROP_API_KEY=your_zendrop_api_key
ZENDROP_BASE_URL=https://api.zendrop.com/v1

# Business Rules
HOLD_BUFFER_HOURS=6
DEFAULT_MARKUP_MULTIPLIER=2.5
DEFAULT_SHIPPING_BUFFER_USD=3.00

# Two-factor authentication (OTP) — runtime-overridable via PUT /api/auth/settings
OTP_ISSUER="Retailer Dropshipping Admin"
OTP_LENGTH=6
OTP_STEP_SECONDS=30
OTP_WINDOW_STEPS=1
OTP_SESSION_TTL_MINUTES=5
AUTH_REQUIRE_OTP=true

# Rate limiting — runtime-overridable via PUT /api/auth/settings
RATE_LIMIT_API_WINDOW_SEC=900
RATE_LIMIT_API_MAX=600
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_OTP_WINDOW_SEC=900
RATE_LIMIT_OTP_MAX=6
